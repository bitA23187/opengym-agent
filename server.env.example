# Legacy server example. For new installs use agent.env.example and docs/AGENT_DEPLOYMENT.md.
RP_ID=gym.example.com
ORIGIN=https://gym.example.com
RP_NAME=openGym
DEFAULT_LANG=zh

# Locked after owner bootstrap. A fresh deployment needs protected initialization;
# temporarily enable first-user admin and signup only behind a restricted entrance.
FIRST_USER_ADMIN=0
INVITE_ONLY=1
ALLOW_GUEST=0

# Invited users may register with a password; existing users set one in Account.
PASSWORD_LOGIN=1

# Coach and all server-side AI provider runtimes stay disabled.
COACH_DISABLED=1

# Explicit timezone fallback for older Agent tool schemas that omit timezone.
# Each account reminder timezone and an explicit tool argument take precedence.
PLUGIN_DEFAULT_TIMEZONE=Asia/Taipei
# Optional: comma-separated IDs of account owners who explicitly opted into
# direct ordinary training-record saves. Plans/deletes/context still confirm.
PLUGIN_TRAINING_AUTO_SAVE_USER_IDS=
