# Local bootstrap only. Copy to agent.env; do not commit the resulting file.
RP_ID=localhost
ORIGIN=http://localhost:8080
RP_NAME=openGym Agent
DEFAULT_LANG=zh
SESSION_DAYS=90
# Register the owner while access is restricted; then set FIRST_USER_ADMIN=0,
# INVITE_ONLY=1 and restart before sharing your HTTPS address.
FIRST_USER_ADMIN=1
INVITE_ONLY=0
ALLOW_GUEST=0
PASSWORD_LOGIN=1
COACH_DISABLED=1
# Enable only after ORIGIN uses your working HTTPS domain.
PLUGIN_ENABLED=0
# Choose your own IANA timezone.
PLUGIN_DEFAULT_TIMEZONE=Asia/Taipei
# Keep empty unless each account owner explicitly opts in to direct saves.
PLUGIN_TRAINING_AUTO_SAVE_USER_IDS=
PLUGIN_NUTRITION_AUTO_SAVE_USER_IDS=
